{
  "name": "mynews-server",
  "version": "1.0.0",
  "private": true,
  "description": "My News backend: hourly RSS collection, story grouping, Wikipedia background, Claude summaries, JSON API.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "collect": "node --env-file-if-exists=.env scripts/collect.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "load-fixtures": "node --env-file-if-exists=.env scripts/load-fixtures.js",
    "test": "AI_REQUEST_GAP_MS=1 node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@google/genai": "^2.30.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
