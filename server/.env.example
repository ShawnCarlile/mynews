# Copy to .env for local development. Never commit real values.

# Postgres connection string (Supabase: Project Settings > Database > Connection string > "Session pooler").
# Leave empty locally to use the embedded PGlite database in ./.data/pglite.
DATABASE_URL=

# Google Gemini API key for AI summaries, from https://aistudio.google.com/apikey
# (server only; never put this in the Flutter app).
GEMINI_API_KEY=REPLACE_ME
# Optional overrides (defaults shown).
GEMINI_MODEL=gemini-3.8-flash
MAX_SUMMARIES_PER_RUN=15
AI_REQUEST_GAP_MS=6000

# Shared secret for POST /admin/collect (used by the hourly scheduler and for instructor demos).
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STRING

# Contact for the Wikipedia API User-Agent (Wikipedia rate-limits clients without one).
CONTACT_EMAIL=you@example.edu

# Set true only on hosts that keep the process running 24/7 (not Render's free tier).
ENABLE_INTERNAL_SCHEDULER=false

# Show the fictional fixture stories (labeled DEMO FIXTURE) in the API. Keep false in normal use.
INCLUDE_FIXTURES=false

# Testing only: JSON map of publisher id -> feed URL, e.g. {"npr":"https://example.invalid/feed"} to simulate a broken feed.
FEED_URL_OVERRIDES=

PORT=8080
